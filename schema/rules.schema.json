{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimc1682000/timesheet/schema/rules.schema.json",
  "title": "timesheet rules",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "keywords": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "meetings": {
      "type": "object",
      "properties": {
        "default": { "type": "string" },
        "exceptions": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unknown": { "enum": ["ask"], "default": "ask" }
  }
}
